{
  "name": "event-seating-planner",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "planner-app": "pnpm --filter planner-app",
    "guest-app": "pnpm --filter guest-app",
    "display-app": "pnpm --filter display-app",
    "@app/shared": "pnpm --filter @app/shared",
    "database": "pnpm --filter @app/database",
    "db:push": "pnpm --filter @app/database db:push",
    "db:generate": "pnpm --filter @app/database db:generate",
    "prisma:dev": "pnpm --filter @app/database exec npx prisma dev",
    "prisma:migrate": "pnpm --filter @app/database exec npx prisma migrate dev --name",
    "prisma:init": "pnpm --filter @app/database exec npx prisma init",
    "db:seed": "pnpm --filter @app/database db:seed",
    "server": "pnpm --filter server",
    "build": "pnpm run db:generate && pnpm --filter @app/database build && pnpm --filter server build",
    "postinstall": "pnpm run db:generate",
    "lint": "eslint apps/planner-app/src apps/guest-app/src shared/src"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.7.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.60.0"
  }
}
